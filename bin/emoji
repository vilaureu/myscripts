#!/usr/bin/env bash

# Simple wrapper around hb-raster and ImageMagick to render emojis as PNG images.
#
# Usage:
#   emoji OUTPUT_FILE EMOJI_TEXT
# where:
#   OUTPUT_FILE : path to output PNG file
#   EMOJI_TEXT  : emoji text to render (e.g. "😀", "❤️")

set -euo pipefail

font=${EMOJI_FONT_FILE:-~/.local/share/Noto-COLRv1.ttf}
hb-raster --background=00000000 --margin=0 --font-size=1000 --output-file="$1" -- "$font" "$2"
magick "$1" -trim "$1"
